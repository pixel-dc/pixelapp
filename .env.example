# Lo único que vive fuera de la base de datos. Todo lo demás (llaves de Claude, apps de Meta, integraciones) se guarda cifrado
# por bot y se edita desde el panel.

# Clave maestra AES-256 (32 bytes en base64). Genérala con:  openssl rand -base64 32
# Si se pierde, los secretos guardados en la base no se pueden descifrar: respáldala aparte de la base.
Secrets__MasterKey=

# Conexión a PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=pixela;Username=pixela;Password=dev_only_change_me
