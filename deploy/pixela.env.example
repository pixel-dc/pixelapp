# /etc/pixela/pixela.env  (root:pixela, permisos 640). Es TODO lo que Pixela necesita fuera de la base.

# Llave maestra: cifra las llaves de Claude, apps de Meta, tokens y 2FA guardados en la base.
# Generar una sola vez con:  openssl rand -base64 32
# Guárdala también fuera del servidor: sin ella, los secretos de una copia de la base no se pueden descifrar.
Secrets__MasterKey=

# Conexión a PostgreSQL
ConnectionStrings__Default=Host=localhost;Database=pixela;Username=pixela;Password=

# Accesos por cliente: cada cliente entra por {slug}.<este dominio>, instala la app con su nombre e icono y recibe solo sus
# notificaciones. Vacío = sin accesos por cliente. Necesita el DNS comodín y el bloque *.dominio del Caddyfile.
ClientApps__Domain=pixelapp.pixeldc.com
